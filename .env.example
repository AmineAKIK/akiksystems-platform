NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/akiksystems
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com

# S3-compatible contextual asset storage:
BUCKET=replace-with-bucket-name
REGION=auto
ENDPOINT=https://replace-with-storage-endpoint
ACCESS_KEY_ID=replace-with-access-key
SECRET_ACCESS_KEY=replace-with-secret-key

# Set only for the one-time server-side bootstrap command:
# ADMIN_PASSWORD=replace-with-a-strong-one-time-bootstrap-password
