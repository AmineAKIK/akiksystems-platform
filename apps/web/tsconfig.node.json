{
  "extends": "./tsconfig.json",
  "include": ["server.js", "vite.config.ts", "react-router.config.ts", "scripts/**/*.mjs"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "composite": true,
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ES2022",
    "types": ["node"]
  }
}
