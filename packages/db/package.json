{
  "name": "@akiksystems/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./health": {
      "types": "./health.d.ts",
      "default": "./health.mjs"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "db:check": "tsx src/cli/check.ts",
    "db:verify": "tsx src/cli/verify.ts",
    "db:verify-assets": "tsx src/cli/verify-assets.ts",
    "db:verify-system-domain": "tsx src/cli/verify-system-domain.ts",
    "db:verify-system-experiences": "tsx src/cli/verify-system-experiences.ts",
    "db:verify-system-technologies": "tsx src/cli/verify-system-technologies.ts",
    "migrate:down": "tsx src/cli/migrate.ts down",
    "migrate:latest": "tsx src/cli/migrate.ts latest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:verify-system-links": "tsx src/cli/verify-system-links.ts",
    "db:verify-presentation-documents": "tsx src/cli/verify-presentation-documents.ts",
    "db:verify-publication-readiness": "tsx src/cli/verify-publication-readiness.ts",
    "db:verify-independent-publication": "tsx src/cli/verify-independent-publication.ts",
    "db:verify-admin-audit": "tsx src/cli/verify-admin-audit.ts",
    "db:verify-public-system": "tsx src/cli/verify-public-system.ts",
    "db:verify-published-systems-list": "tsx src/cli/verify-published-systems-list.ts",
    "db:verify-system-editorial-controls": "tsx src/cli/verify-system-editorial-controls.ts",
    "db:verify-protocap-domain": "tsx src/cli/verify-protocap-domain.ts",
    "db:verify-oria-domain": "tsx src/cli/verify-oria-domain.ts",
    "db:verify-tugeres-domain": "tsx src/cli/verify-tugeres-domain.ts",
    "db:verify-system-proof-transparency": "tsx src/cli/verify-system-proof-transparency.ts",
    "db:verify-system-references": "tsx src/cli/verify-system-references.ts",
    "db:verify-training-domain": "tsx src/cli/verify-training-domain.ts",
    "db:verify-credential-domain": "tsx src/cli/verify-credential-domain.ts",
    "db:verify-learning-artifact-domain": "tsx src/cli/verify-learning-artifact-domain.ts",
    "db:verify-system-publication-snapshots": "tsx src/cli/verify-system-publication-snapshots.ts",
    "db:bootstrap-tugeres-qualification": "tsx src/cli/bootstrap-tugeres-qualification.ts",
    "db:bootstrap-oria-qualification": "tsx src/cli/bootstrap-oria-qualification.ts",
    "db:bootstrap-protocap-qualification": "tsx src/cli/bootstrap-protocap-qualification.ts",
    "db:bootstrap-training-qualification": "tsx src/cli/bootstrap-training-qualification.ts",
    "db:bootstrap-credential-qualification": "tsx src/cli/bootstrap-credential-qualification.ts",
    "db:bootstrap-learning-artifact-qualification": "tsx src/cli/bootstrap-learning-artifact-qualification.ts",
    "db:verify-public-profile": "tsx src/cli/verify-public-profile.ts",
    "profile:bootstrap-publications": "tsx src/cli/bootstrap-profile-publication.ts",
    "systems:bootstrap-publications": "tsx src/cli/bootstrap-system-publications.ts"
  },
  "dependencies": {
    "@akiksystems/config": "workspace:*",
    "@akiksystems/core": "workspace:*",
    "kysely": "0.29.6",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.13"
  }
}
